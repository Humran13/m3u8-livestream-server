# Generated by M3U8 Livestream Server - do not edit by hand.
# Regenerated automatically by lib/relay.sh (install/repair only; never
# rewritten per-relay - this is a systemd template unit, instantiated as
# m3u8-relay@<name>.service for each configured relay).
#
# Deliberately NO User=/Group= here: the unit starts as root so the
# runner script can read this relay's config from a root:root/700/600
# file (which may contain source-URL credentials/tokens that must never
# be readable by www-data or any other unrelated service identity). The
# runner reads that config, then permanently drops to the unprivileged
# __RELAY_USER__ account via setpriv BEFORE FFmpeg - the process that
# actually talks to the network - ever starts. FFmpeg itself never runs
# as root; this unit's brief root context never touches the network.

[Unit]
Description=M3U8 Livestream Server relay: %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
ExecStart=__RELAY_RUNNER__ %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=__RELAY_HLS_ROOT__

# All four below have been supported since systemd 232/235, which is
# older than every targeted Ubuntu release's systemd (18.04 ships 237) -
# safe to include unconditionally. PrivateDevices blocks access to
# physical/hardware devices; if hardware-accelerated transcoding (VAAPI/
# NVENC/etc.) is added in a future phase, that feature will need to
# either disable this or add specific DeviceAllow= exceptions - Phase B
# is software-only, so it stays on by default here.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
__RESTRICT_SUIDSGID_LINE__

[Install]
WantedBy=multi-user.target
