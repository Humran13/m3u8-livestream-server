# Generated by M3U8 Livestream Server - do not edit by hand.
# Regenerated automatically by lib/nginx.sh. Any manual edits will be lost
# the next time a channel is added, removed, enabled, disabled or the
# installer is re-run.
#
# This file is included from the top level of /etc/nginx/nginx.conf (outside
# the http {} block), which is where the RTMP module's directives must live.

rtmp {
    server {
        listen __RTMP_PORT__;
        chunk_size 4096;
        # Buffer a little before the encoder is considered gone; avoids
        # flapping "offline" state on brief network hiccups.
        timeout 15s;

        application __RTMP_APP__ {
            live on;
            record off;

            # ngx_rtmp_notify_module parses on_publish into a STATIC URL at
            # config-load time - it does not interpolate RTMP variables
            # (like $name) into that string per-request the way core
            # nginx's proxy_pass does. The module supplies the real stream
            # name itself, as one of its own parameters (app, name, type,
            # etc.), using whichever transport notify_method selects. The
            # default (post) puts those in the request body, which plain
            # $arg_* variables on the HTTP side can never see. Using "get"
            # makes the module append them as a real query string onto the
            # URL below, so $arg_name on the auth server actually reflects
            # the stream name being published - a bare URL with no manual
            # "?name=$name" appended (that literal string would never have
            # been substituted).
            notify_method get;
            on_publish http://127.0.0.1:__AUTH_PORT__/auth;

            hls on;
            hls_path __HLS_DIR__;
            hls_fragment __HLS_FRAGMENT__;
            hls_playlist_length __HLS_PLAYLIST_LENGTH__;
            hls_cleanup on;
            hls_continuous on;
            hls_nested off;
            wait_key on;
            wait_video on;
        }
    }
}
