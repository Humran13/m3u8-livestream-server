# Generated by M3U8 Livestream Server - do not edit by hand.
# Regenerated automatically by lib/nginx.sh (HTTP-only variant, no SSL).
#
# This file is dropped into /etc/nginx/sites-available and symlinked from
# sites-enabled, so it is loaded inside nginx's existing http {} block
# without any changes to the main nginx.conf.

# map_hash_bucket_size must be large enough to hold the longest stream key
# plus Nginx's per-entry hash overhead. Project-generated keys are 48
# characters; manually-entered keys are validated up to 128 characters
# (see is_valid_stream_key in lib/common.sh) - 256 bytes gives comfortable
# headroom for the full allowed range. This is an http-context-only
# directive; it lives here (not in nginx.conf) because this whole file is
# already loaded inside Nginx's http {} block via sites-enabled.
map_hash_bucket_size 256;

# Stream-key allow list, regenerated whenever a channel is added, removed,
# enabled, disabled or its key is rotated. Unknown or disabled keys map to 0
# and are rejected by the /auth endpoint below.
map $arg_name $m3u8_stream_allowed {
    default 0;
    include __STREAMKEYS_MAP__;
}

# Loopback-only endpoint used by the RTMP application's on_publish callback
# to authorize (or reject) an incoming publish by stream key.
server {
    listen 127.0.0.1:__AUTH_PORT__;
    server_name _;
    access_log off;

    location = /auth {
        __AUTH_LOCATION_BODY__
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __WEB_ROOT__;
    index index.html;

    # Required for Let's Encrypt HTTP-01 domain validation.
    location ^~ /.well-known/acme-challenge/ {
        root __WEB_ROOT__;
        default_type "text/plain";
    }

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        root __WEB_ROOT__;
    }

    # Per-channel player pages are served by the same static index.html,
    # which reads the channel name from the URL client-side.
    location /watch/ {
        alias __WEB_ROOT__/;
        try_files $uri $uri/ /index.html;
    }

    location = /channels.generated.json {
        alias __CHANNELS_JSON__;
        add_header Cache-Control "no-cache";
        default_type application/json;
    }

    location /hls/ {
        alias __HLS_DIR__/;
        add_header Cache-Control "no-cache";
        add_header Access-Control-Allow-Origin * always;
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t ts;
        }
    }
}
