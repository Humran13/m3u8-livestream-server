#!/usr/bin/env bash
# m3u8-manager - interactive day-to-day administration tool for the
# M3U8 Livestream Server. Installed as /usr/local/bin/m3u8-manager, but this
# file is also runnable directly from the project checkout before install.

set -Eeuo pipefail

# Resolve the real directory of this script even when invoked through the
# /usr/local/bin symlink created by install.sh.
_m3u8_source="${BASH_SOURCE[0]}"
while [ -h "$_m3u8_source" ]; do
    _m3u8_dir="$(cd -P "$(dirname "$_m3u8_source")" && pwd)"
    _m3u8_source="$(readlink "$_m3u8_source")"
    [[ "$_m3u8_source" != /* ]] && _m3u8_source="${_m3u8_dir}/${_m3u8_source}"
done
M3U8_SCRIPT_DIR="$(cd -P "$(dirname "$_m3u8_source")" && pwd)"
M3U8_PROJECT_ROOT="$M3U8_SCRIPT_DIR"

# shellcheck source=lib/common.sh
source "${M3U8_SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/osdetect.sh
source "${M3U8_SCRIPT_DIR}/lib/osdetect.sh"
# shellcheck source=lib/nginx.sh
source "${M3U8_SCRIPT_DIR}/lib/nginx.sh"
# shellcheck source=lib/streams.sh
source "${M3U8_SCRIPT_DIR}/lib/streams.sh"
# shellcheck source=lib/ssl.sh
source "${M3U8_SCRIPT_DIR}/lib/ssl.sh"
# shellcheck source=lib/firewall.sh
source "${M3U8_SCRIPT_DIR}/lib/firewall.sh"
# shellcheck source=lib/relay.sh
source "${M3U8_SCRIPT_DIR}/lib/relay.sh"
# shellcheck source=lib/diagnostics.sh
source "${M3U8_SCRIPT_DIR}/lib/diagnostics.sh"
# shellcheck source=lib/selftest.sh
source "${M3U8_SCRIPT_DIR}/lib/selftest.sh"

require_root "$@"

pause() {
    printf '\nPress Enter to continue...'
    read -r _ </dev/tty || true
}

require_streams_or_notice() {
    local names
    names="$(list_stream_names || true)"
    if [ -z "$names" ]; then
        log_info 'No channels are configured yet. Use "Add Stream / Channel" first.'
        return 1
    fi
    printf '%s' "$names"
    return 0
}

pick_stream() {
    local names name i=1 choice
    names="$(require_streams_or_notice)" || return 1
    {
        printf 'Channels:\n'
        while IFS= read -r name; do
            printf '  %d. %s\n' "$i" "$name"
            i=$((i + 1))
        done <<<"$names"
    } >&2
    choice="$(ask "Select a channel by number" "1")"
    name="$(printf '%s\n' "$names" | sed -n "${choice}p")"
    [ -n "$name" ] || { log_error "Invalid selection."; return 1; }
    printf '%s' "$name"
}

pick_relay() {
    local names name i=1 choice
    names="$(list_relay_names || true)"
    if [ -z "$names" ]; then
        log_info 'No relays are configured yet. Use "Add Relay" first.'
        return 1
    fi
    {
        printf 'Relays:\n'
        while IFS= read -r name; do
            printf '  %d. %s [%s]\n' "$i" "$name" "$(relay_health "$name")"
            i=$((i + 1))
        done <<<"$names"
    } >&2
    choice="$(ask "Select a relay by number" "1")"
    name="$(printf '%s\n' "$names" | sed -n "${choice}p")"
    [ -n "$name" ] || { log_error "Invalid selection."; return 1; }
    printf '%s' "$name"
}

# ---------------------------------------------------------------------------
# Menu actions
