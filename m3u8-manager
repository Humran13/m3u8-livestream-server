uninstall_menu() {
    print_banner "UNINSTALL SERVER"
    log_warn "Uninstalling removes this project's nginx configuration, manager command,"
    log_warn "and optionally its HLS files, backups and certificates. This cannot be undone."
    if confirm "Run the uninstaller now?" "n"; then
        if [ -x "${M3U8_INSTALL_DIR}/uninstall.sh" ]; then
            exec "${M3U8_INSTALL_DIR}/uninstall.sh"
        else
            exec "${M3U8_PROJECT_ROOT}/uninstall.sh"
        fi
    else
        log_info "Uninstall cancelled."
    fi
}

