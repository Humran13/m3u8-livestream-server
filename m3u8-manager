backup_config_menu() {
    print_banner "BACKUP CONFIGURATION" >&2
    local ts dest
    ts="$(date '+%Y%m%d%H%M%S')"
    ensure_dir "$M3U8_BACKUP_DIR" 700 root:root
    dest="${M3U8_BACKUP_DIR}/backup-${ts}.tar.gz"
    tar -czf "$dest" -C / \
        --exclude="${M3U8_BACKUP_DIR#/}" \
        "${M3U8_CONFIG_DIR#/}" \
        "${M3U8_NGINX_SITE_FILE#/}" \
        "${M3U8_NGINX_RTMP_CONF#/}" \
        2>/dev/null || true
    chmod 600 "$dest"
    log_ok "Backup created: $dest"
    # Printed to stdout (unlike the messages above) so a caller can do
    # safety_backup="$(backup_config_menu)" to capture the path for a
    # possible rollback, e.g. restore_config_menu below.
    printf '%s' "$dest"
}

restore_config_menu() {
    print_banner "RESTORE CONFIGURATION"
    local backups i=1 choice file
    ensure_dir "$M3U8_BACKUP_DIR" 700 root:root
    backups="$(find "$M3U8_BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | sort -r)"
    if [ -z "$backups" ]; then
        log_info "No backups found in $M3U8_BACKUP_DIR"
        return 0
    fi
    printf 'Available backups:\n'
    while IFS= read -r file; do
        printf '  %d. %s\n' "$i" "$(basename "$file")"
        i=$((i + 1))
    done <<<"$backups"
    choice="$(ask "Select a backup to restore by number" "")"
    file="$(printf '%s\n' "$backups" | sed -n "${choice}p")"
    [ -n "$file" ] || { log_error "Invalid selection."; return 0; }
    log_warn "Restoring will overwrite the current configuration in $M3U8_CONFIG_DIR and the generated nginx files."
    confirm "A safety backup of the CURRENT configuration will be made first. Continue?" "n" || { log_info "Cancelled."; return 0; }
    local safety_backup domain ssl_enabled
    safety_backup="$(backup_config_menu)"

    tar -xzf "$file" -C /
    domain="$(conf_get "$M3U8_SERVER_CONF" DOMAIN 2>/dev/null || echo "")"
    ssl_enabled="$(conf_get "$M3U8_SERVER_CONF" SSL_ENABLED 2>/dev/null || echo "false")"
    regenerate_streamkeys_map || true
    [ -n "$domain" ] && sync_channels_json "$domain" "$ssl_enabled"

    # A restored backup must never be trusted blindly: only reload if the
    # restored site/RTMP files (extracted verbatim from the archive, not
    # regenerated) actually pass `nginx -t`. If they don't, automatically
    # roll back to the safety backup taken moments ago, rather than
    # leaving an unvalidated foreign configuration on disk.
    if reload_nginx; then
        log_ok "Configuration restored and nginx reloaded."
        return 0
    fi

    log_error "Restored configuration failed Nginx validation. Rolling back to the pre-restore configuration..."
    if [ -z "$safety_backup" ] || [ ! -f "$safety_backup" ]; then
        log_error "No safety backup path available; the previous working Nginx configuration is still the one actually running. Restore manually from $M3U8_BACKUP_DIR if needed."
        return 1
    fi

    tar -xzf "$safety_backup" -C /
    domain="$(conf_get "$M3U8_SERVER_CONF" DOMAIN 2>/dev/null || echo "")"
    ssl_enabled="$(conf_get "$M3U8_SERVER_CONF" SSL_ENABLED 2>/dev/null || echo "false")"
    regenerate_streamkeys_map || true
    [ -n "$domain" ] && sync_channels_json "$domain" "$ssl_enabled"
    if reload_nginx; then
        log_ok "Rolled back successfully; the pre-restore configuration is active again."
    else
        log_error "Rollback also failed validation. Manual intervention required. Safety backup is at: $safety_backup"
    fi
}

