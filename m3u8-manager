auth_diagnostics_menu() {
    print_banner "RTMP AUTHENTICATION DIAGNOSTICS"
    local mode
    mode="$(current_auth_mode)"
    printf 'Current auth mode: %s\n' "$mode"
    if [ "$mode" = "off" ]; then
        log_warn "RTMP publishing authentication is DISABLED."
        log_warn "Anyone who can reach port ${M3U8_RTMP_PORT} can publish to this server."
    fi
    printf '\n1. Run authentication self-test\n2. Switch to stream-key mode (secure, default)\n3. Switch to OFF mode (diagnostics only - INSECURE)\n0. Back\n'
    case "$(ask "Choice" "0")" in
        1) printf '\n'; test_auth_endpoint ;;
        2)
            if [ "$mode" = "stream-key" ]; then
                log_info "Already in stream-key mode."
            elif set_auth_mode "stream-key" && reload_nginx; then
                log_ok "Auth mode set to stream-key (secure)."
            else
                log_error "Could not switch to stream-key mode; see above."
            fi
            ;;
        3)
            log_warn "This will allow ANYONE who can reach port ${M3U8_RTMP_PORT} to publish to this server."
            if confirm "Disable RTMP publishing authentication?" "n"; then
                if set_auth_mode "off" && reload_nginx; then
                    log_warn "WARNING: RTMP publishing authentication is disabled."
                    log_warn "Anyone who can reach port ${M3U8_RTMP_PORT} can publish to this server."
                    log_warn "Re-enable it (option 2) as soon as diagnostics are finished."
                else
                    log_error "Could not switch auth mode; see above."
                fi
            else
                log_info "Cancelled."
            fi
            ;;
        *) ;;
    esac
}

