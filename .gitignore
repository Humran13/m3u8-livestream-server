# --- OS / filesystem clutter ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE files ---
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# --- Logs ---
*.log
install.log
npm-debug.log*

# --- Generated HLS output directories -----------------------------------
# On a real install, segments/playlists/manifest live under
# /var/www/m3u8-server (outside this repo entirely). These entries only
# matter for local testing, where someone might point the HLS/web root at
# a directory inside the checkout. Scoped to those specific runtime
# directories only - *.ts and *.m3u8 are NOT ignored project-wide, so any
# real source file with those extensions elsewhere in the repo is safe.
hls/
web/hls/
media/
test-output/
local-test/
.local-hls/

# Belt-and-suspenders: explicit patterns in case one of the above
# directories is ever tracked with a non-standard layout.
hls/**/*.m3u8
hls/**/*.ts
web/hls/**/*.m3u8
web/hls/**/*.ts
media/**/*.m3u8
media/**/*.ts
test-output/**/*.m3u8
test-output/**/*.ts
local-test/**/*.m3u8
local-test/**/*.ts

# The public channel manifest is generated at runtime by lib/nginx.sh
# (sync_channels_json) into the web root as channels.generated.json.
# Scoped to the same runtime/local-test locations - never ignored as a
# bare "channels.generated.json" so a legitimate sample or fixture file
# elsewhere (e.g. a future static channels.json fixture) is never hidden.
web/channels.generated.json
web/hls/channels.generated.json
test-output/channels.generated.json
local-test/channels.generated.json

# Same treatment for the relay manifest (Phase B) - generated by
# lib/relay.sh (sync_relay_manifest), scoped the same way.
web/relays.generated.json
web/hls/relays.generated.json
test-output/relays.generated.json
local-test/relays.generated.json
hls/relay/
web/hls/relay/

# --- Local/staged runtime config that would only ever appear during
#     local testing - production config lives on the VPS under
#     /etc/m3u8-server, never inside this repository ---
server.conf
streams/
streamkeys.map
relays/
*.stream-key
*.env
.env.*
secrets/
secrets.*

# --- Backups / archives generated by m3u8-manager or ad hoc testing ---
*.bak
*.bak.*
*.tar.gz
*.tgz
backup-*.tar.gz
backups/

# --- Certificates / private keys (should never live in this repo) ---
*.pem
*.key
*.crt
*.p12
letsencrypt/

# --- Editor swap / temp files ---
*.tmp
*.temp
.tmp/

# --- Shell script test/debug leftovers ---
*.orig
